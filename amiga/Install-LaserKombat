; $VER: Install-LaserKombat 1.0-gfos1 (16.11.2026)
; The Amiga Installer script for Laser Kombat, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the LaserKombat drawer where the archive was unpacked.

(set @app-name "Laser Kombat")
(set #version "1.0-gfos1")
(set #drawer "LaserKombat")
(set #program "LaserKombat")
(set #space 8790)  ; KB

(onerror
    (message (cat "Laser Kombat was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-LaserKombat again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Laser Kombat needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Laser Kombat needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Laser Kombat needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The LaserKombat drawer is not beside Install-LaserKombat. Unpack the whole archive, then run Install-LaserKombat from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The LaserKombat drawer has no LaserKombat in it. Unpack the whole archive again."))

(welcome "This installs Laser Kombat 1.0-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the LaserKombat drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called LaserKombat in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Laser Kombat needs 9 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "Laser Kombat needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-LaserKombat again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Laser Kombat")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Laser Kombat. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "LaserKombat.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "LaserKombat.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Laser Kombat would have gone in " #dest "."))
    (message (cat "Laser Kombat 1.0-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the LaserKombat drawer and double-click the LaserKombat icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
